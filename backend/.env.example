# Copy this file to .env and fill in your own values.
# .env is gitignored and is used ONLY for local development.
# In production (Render / Railway / Vercel) set the same keys as
# environment variables on the hosting platform instead.

# --- Django core -----------------------------------------------------------
# Set to "False" in production. When False, DJANGO_SECRET_KEY is required.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# Comma-separated list of allowed hosts. Defaults cover localhost and the
# common hosts, so only override when you need something custom.
# DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app,.onrender.com,.railway.app

# --- Database --------------------------------------------------------------
# Omit DATABASE_URL to use local SQLite (backend/db.sqlite3).
# Set it to your PostgreSQL connection string to use Postgres:
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Render / Railway / Supabase / Vercel provide this URL.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Whether the Postgres connection requires SSL. Defaults to True in
# production (DEBUG=False), False in local development.
# DATABASE_SSL_REQUIRE=True

# --- HTTPS proxy trust (Render / Railway / Vercel) -------------------------
# Keep True so Django trusts the platform's HTTPS proxy (X-Forwarded-Proto).
# Set to False if the app is served directly without a proxy.
# DJANGO_TRUST_PROXY=True

# --- Email (SMTP) ----------------------------------------------------------
# Leave EMAIL_HOST empty to print emails to the console in development.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=BookMySeat <bookmyseat.official26@gmail.com>
# Public base URL used for absolute links inside emails, e.g. https://app.onrender.com
# SITE_URL=

# --- Email via Brevo HTTPS API (recommended for Render free tier) ----------
# Render free instances block outbound SMTP ports (25/465/587). Setting
# BREVO_API_KEY makes emails go through Brevo's HTTPS API (port 443) instead:
#   1. Sign up at https://brevo.com (free) and verify your sender email.
#   2. Settings > SMTP & API > API Keys > generate an "xkeysib-..." key.
#   3. Set it here / in production env. When set, EMAIL_HOST_* is ignored.
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Email outbox retry (see movies.models.EmailOutbox) --------------------
# EMAIL_OUTBOX_MAX_ATTEMPTS=6
# EMAIL_OUTBOX_BACKOFF_BASE_SECONDS=60
# EMAIL_OUTBOX_CLAIM_MAX_AGE_SECONDS=600

# --- Persistent media storage (production) ---------------------------------
# Render's disk is EPHEMERAL: uploads vanish on restart/redeploy unless they
# go to persistent storage. When CLOUDINARY_URL is set, all ImageField /
# FileField uploads (movie posters, banners, thumbnails, cast photos, gallery
# images) are stored on Cloudinary and survive restarts forever.
# Leave unset for local development — media then stays in backend/media/ as
# before. Get the URL from Cloudinary Dashboard > "API Environment variable":
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# On Render set it in Dashboard -> BookMySeat web service -> Environment.
# CLOUDINARY_URL=cloudinary://key:secret@cloudname

# --- Cache (optional, recommended for multi-instance deployment) -----------
# Redis URL enables django-redis caching across workers. Omit to use a
# per-process in-memory cache (fine for single-instance dev).
# REDIS_URL=redis://default:pass@host:6379

# --- Secure cookies (defaults flip automatically in production) ------------
# COOKIE_SECURE=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# --- Razorpay payment gateway ----------------------------------------------
# Test keys are found at https://dashboard.razorpay.com (Test Mode).
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Used to verify Razorpay webhooks (Dashboard > Settings > Webhooks).
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# When True the checkout page shows a demo pay button that simulates a
# successful payment so the flow works without real keys.
RAZORPAY_DEMO_MODE=True
